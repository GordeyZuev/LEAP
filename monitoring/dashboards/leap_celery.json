{
  "annotations": {
    "list": []
  },
  "description": "Celery workers, queues, pipeline throughput and stage duration. Top stat shows worker health at a glance.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Drill-down",
      "type": "dashboards",
      "tags": ["leap"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Workers",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active workers",
      "description": "Celery workers reporting alive. RED = no workers — pipeline is down.",
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(celery_worker_up == 1) or vector(0)",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {"titleSize": 14, "valueSize": 40}
      }
    },
    {
      "type": "stat",
      "title": "Task failure rate (5m)",
      "description": "Failed / received Celery tasks. Shows 0 when idle.",
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(celery_task_failed_total[5m])) / clamp_min(sum(rate(celery_task_received_total[5m])), 1e-9) or vector(0)",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Pending tasks",
      "description": "Total messages waiting in all Celery queues.",
      "gridPos": {"x": 12, "y": 1, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(celery_queue_length) or vector(0)",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 200}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Tasks received / min",
      "description": "Inbound task rate across all queues.",
      "gridPos": {"x": 18, "y": 1, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(celery_task_received_total[5m])) * 60 or vector(0)",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },

    {
      "type": "row",
      "title": "Queues",
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Queue depth per queue",
      "description": "Pending messages per Celery queue (celery-exporter).",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "celery_queue_length",
          "legendFormat": "{{queue_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "type": "timeseries",
      "title": "Oldest task age per queue",
      "description": "Age of the oldest pending task from Redis leap:enq:* (not broker length). Members older than 7 days are dropped as tracker leftovers. Yellow >5min, red >15min.",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "leap_queue_oldest_task_age_seconds",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 300},
              {"color": "red", "value": 900}
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "thresholdsStyle": {"mode": "area"},
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      }
    },

    {
      "type": "row",
      "title": "Task throughput",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Succeeded tasks / min by name",
      "description": "Top pipeline tasks by success rate.",
      "gridPos": {"x": 0, "y": 17, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (name) (rate(celery_task_succeeded_total{name=~\"api.tasks.*\"}[5m])) * 60)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {"drawStyle": "line", "fillOpacity": 20, "spanNulls": true}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "type": "timeseries",
      "title": "Failed tasks / min by name",
      "description": "celery_task_failed_total (final failures). Retries are not counted here — see Recent Celery task failures / RETRY logs.",
      "gridPos": {"x": 12, "y": 17, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(celery_task_failed_total{name=~\"api.tasks.*\"}[5m])) * 60 > 0",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {"mode": "normal"},
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]},
        "tooltip": {"mode": "multi"}
      }
    },

    {
      "type": "row",
      "title": "Pipeline (Postgres)",
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Recordings completed (24h)",
      "description": "Recordings that reached READY or UPLOADED with pipeline_completed_at in the last 24h.",
      "gridPos": {"x": 0, "y": 27, "w": 8, "h": 4},
      "datasource": {"type": "postgres", "uid": "leap_db"},
      "targets": [{"refId": "A", "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM recordings WHERE pipeline_completed_at > NOW() - INTERVAL '24 hours' AND NOT failed AND status IN ('READY', 'UPLOADED');"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^value$/"},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Uploads (24h)",
      "description": "output_targets with status UPLOADED in the last 24h.",
      "gridPos": {"x": 8, "y": 27, "w": 8, "h": 4},
      "datasource": {"type": "postgres", "uid": "leap_db"},
      "targets": [{"refId": "A", "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM output_targets WHERE status = 'UPLOADED' AND uploaded_at > NOW() - INTERVAL '24 hours';"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^value$/"},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Pipeline failures (24h)",
      "description": "recordings.failed in the last 24h. MTS conversion wait is not a failure.",
      "gridPos": {"x": 16, "y": 27, "w": 8, "h": 4},
      "datasource": {"type": "postgres", "uid": "leap_db"},
      "targets": [{"refId": "A", "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM recordings WHERE failed AND failed_at > NOW() - INTERVAL '24 hours';"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^value$/"},
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Stage duration avg by stage (Postgres)",
      "description": "Mean duration_seconds from completed stage_timings (no substeps). Sparse Prometheus histograms are not used here.",
      "gridPos": {"x": 0, "y": 31, "w": 16, "h": 10},
      "datasource": {"type": "postgres", "uid": "leap_db"},
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', completed_at) AS time, stage_type::text AS metric, ROUND(AVG(duration_seconds)::numeric, 1) AS value FROM stage_timings WHERE status = 'COMPLETED' AND substep IS NULL AND duration_seconds IS NOT NULL AND $__timeFilter(completed_at) GROUP BY 1, 2 ORDER BY 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "type": "barchart",
      "title": "Recordings in flight (by status)",
      "description": "Not finished: excludes READY / UPLOADED / EXPIRED / SKIPPED, failed, deleted, paused. PROCESSED often means waiting for upload.",
      "gridPos": {"x": 16, "y": 31, "w": 8, "h": 10},
      "datasource": {"type": "postgres", "uid": "leap_db"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT status::text AS stage, COUNT(*) AS recordings FROM recordings WHERE NOT failed AND NOT deleted AND NOT on_pause AND status NOT IN ('READY', 'UPLOADED', 'EXPIRED', 'SKIPPED') GROUP BY 1 ORDER BY 2 DESC;"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {
        "orientation": "horizontal",
        "xField": "stage",
        "showValue": "always"
      }
    },

    {
      "type": "row",
      "title": "Failures (Loki + Postgres)",
      "gridPos": {"x": 0, "y": 51, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Stage failures (24h, Postgres)",
      "description": "Failed rows in stage_timings — authoritative source for failure counts.",
      "gridPos": {"x": 0, "y": 52, "w": 12, "h": 9},
      "datasource": {"type": "postgres", "uid": "leap_db"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT stage_type AS stage, COUNT(*) AS failures FROM stage_timings WHERE status = 'FAILED' AND substep IS NULL AND completed_at > NOW() - INTERVAL '24 hours' GROUP BY 1 ORDER BY 2 DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "fixed", "fixedColor": "red"}
        }
      },
      "options": {
        "orientation": "horizontal",
        "xField": "stage",
        "showValue": "always",
        "legend": {"displayMode": "hidden"}
      }
    },
    {
      "type": "logs",
      "title": "Recent Celery retries and failures",
      "description": "task_state RETRY (expected backoff) and FAILURE (retries exhausted). WARNING Task failure in postrun is a log, not celery_task_failed_total.",
      "gridPos": {"x": 12, "y": 52, "w": 12, "h": 9},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"leap\", task_state=~\"FAILURE|RETRY\"} | json | line_format \"{{.text}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": false
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["leap", "celery", "pipeline"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "LEAP Workers & Pipeline",
  "uid": "leap-celery",
  "version": 5
}
