NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_VERSION=0.11.2.0

# Server-only. Share Open Graph / generateMetadata fetch the API from Node.
# Docker Compose sets http://api:8000. Local: leave unset (uses NEXT_PUBLIC_API_URL).
# API_INTERNAL_URL=http://localhost:8000

# Server-only. Exact HTTPS origins permitted to embed /embed/{token}.
# EMBED_ALLOWED_ORIGINS=https://courses.example.edu,https://portal.example.org

# Comma-separated LAN IPs for HMR via Network URL (dev only)
# NEXT_DEV_ALLOWED_ORIGINS=192.168.1.5,192.168.1.10
